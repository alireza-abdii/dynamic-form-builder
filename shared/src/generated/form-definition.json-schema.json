{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FormDefinition",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "fields"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "closesAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "access": {
      "type": "string",
      "enum": [
        "public",
        "telegram"
      ]
    },
    "notifyAdmins": {
      "type": "boolean"
    },
    "submitLabel": {
      "type": "string"
    },
    "successMessage": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "type",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]{0,39}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "tel",
              "select",
              "multiselect",
              "jalali-date"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "hint": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          },
          "minLength": {
            "type": "integer",
            "minimum": 0
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1
          },
          "preset": {
            "type": "string",
            "enum": [
              "iran-mobile",
              "national-id",
              "email",
              "postal-code",
              "digits-only"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "integer": {
            "type": "boolean"
          },
          "minItems": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": {
            "type": "integer",
            "minimum": 1
          },
          "minDate": {
            "type": "string"
          },
          "maxDate": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "label"
              ],
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}